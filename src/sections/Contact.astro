<section class="contact-section" id="contact">
	<div class="section-wrap contact-layout">
		<div class="contact-intro" data-reveal>
			<p class="eyebrow eyebrow-light">Start a conversation</p>
			<h2>Have an idea?<br /><span>Let’s explore it.</span></h2>
			<p>Tell us about a class project, a digital challenge, or a collaboration you have in mind.</p>
			<p class="contact-note">We’re an Information Systems student team. This demo form does not send or store your message.</p>
		</div>
		<form class="contact-form" id="contact-form" data-reveal>
			<div class="form-grid">
				<div>
					<label class="field-label" for="contact-name">Your name</label>
					<input class="form-control" id="contact-name" name="name" autocomplete="name" placeholder="Name" required />
				</div>
				<div>
					<label class="field-label" for="contact-email">Email address</label>
					<input class="form-control" id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
				</div>
				<div class="form-field-wide">
					<label class="field-label" for="contact-topic">What would you like to discuss?</label>
					<select class="form-control" id="contact-topic" name="topic" required>
						<option value="" selected disabled>Choose a topic</option>
						<option>Website or web application</option>
						<option>UI/UX design or prototyping</option>
						<option>Database or information system</option>
						<option>IT setup or digital support</option>
						<option>Project collaboration</option>
						<option>Something else</option>
					</select>
				</div>
				<div class="form-field-wide">
					<label class="field-label" for="contact-message">A little about your idea</label>
					<textarea class="form-control" id="contact-message" name="message" rows="4" placeholder="What are you hoping to make or solve?" required></textarea>
				</div>
			</div>
			<button class="button" type="submit">Send an inquiry</button>
			<p class="contact-success" id="contact-success" role="status" hidden>Thanks for reaching out. This demo form is ready to connect to a real inbox.</p>
		</form>
	</div>
</section>